    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/rpc/match_documents",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query_embedding\": {{ JSON.stringify($json.embedding) }},\n  \"match_count\": 5\n}",
        "options": {}
      },
      "id": "b1a1e001-0000-4000-8000-000000000003",
      "name": "Vector search (pgvector via PostgREST)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsClass": "",
        "jsCode": "// PostgREST's RPC endpoint returns a JSON array of {content, source, similarity}.\n// n8n may deliver it as one item (array in .json) or as many items.\nlet rows = [];\nfor (const item of $input.all()) {\n  if (Array.isArray(item.json)) rows.push(...item.json);\n  else rows.push(item.json);\n}\nconst context = rows\n  .map(r => `[source: ${r.source}] ${r.content}`)\n  .join('\\n\\n');\nconst sources = [...new Set(rows.map(r => r.source))];\nconst question = $('Webhook').first().json.body.question;\nreturn [{ json: { question, context, sources } }];"
      },
      "id": "b1a1e001-0000-4000-8000-000000000004",
      "name": "Assemble context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"qwen2.5:7b-instruct-q4_K_M\",\n  \"stream\": false,\n  \"options\": { \"temperature\": 0 },\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You answer using ONLY the provided context. After each claim attach a citation like [source: <doc>]. If the context does not support an answer, say: 'The provided sources don't contain enough information to answer that.' Never guess or use outside knowledge.\" },\n    { \"role\": \"user\", \"content\": {{ JSON.stringify('Question: ' + $json.question + '\\n\\nContext:\\n' + $json.context) }} }\n  ]\n}",
        "options": { "timeout": 120000 }
      },
      "id": "b1a1e001-0000-4000-8000-000000000005",
      "name": "Answer (Ollama, cite/refuse)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "jsCode": "const msg = $json;\nconst answer = (msg.message && msg.message.content) || '';\nconst sources = $('Assemble context').first().json.sources;\nreturn [{ json: { answer, sources } }];"
      },
      "id": "b1a1e001-0000-4000-8000-000000000006",
      "name": "Format response",
