{
  "name": "RAG Doc-QA (no-code arm) — embed → pgvector → cite/refuse",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ask",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1a1e001-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-40, 300],
      "webhookId": "rag-docqa-ask"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/embeddings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"text-embedding-3-small\",\n  \"input\": {{ JSON.stringify($json.body.question) }}\n}",
        "options": {}
      },
      "id": "b1a1e001-0000-4000-8000-000000000002",
      "name": "Embed question",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "OPENAI_HEADER_AUTH", "name": "OpenAI (Authorization: Bearer)" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-PROJECT.supabase.co/rest/v1/rpc/match_documents",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query_embedding\": {{ JSON.stringify($json.data[0].embedding) }},\n  \"match_count\": 5\n}",
        "options": {}
      },
      "id": "b1a1e001-0000-4000-8000-000000000003",
      "name": "Vector search (pgvector)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "SUPABASE_HEADER_AUTH", "name": "Supabase (apikey + Authorization)" }
      }
    },
    {
      "parameters": {
        "jsClass": "",
        "jsCode": "// Supabase RPC returns an array of {content, source, similarity}.\n// n8n may deliver it as one item (array in .json) or as many items.\nlet rows = [];\nfor (const item of $input.all()) {\n  if (Array.isArray(item.json)) rows.push(...item.json);\n  else rows.push(item.json);\n}\nconst context = rows\n  .map(r => `[source: ${r.source}] ${r.content}`)\n  .join('\\n\\n');\nconst sources = [...new Set(rows.map(r => r.source))];\nconst question = $('Webhook').first().json.body.question;\nreturn [{ json: { question, context, sources } }];"
      },
      "id": "b1a1e001-0000-4000-8000-000000000004",
      "name": "Assemble context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 700,\n  \"system\": \"You answer using ONLY the provided context. After each claim attach a citation like [source: <doc>]. If the context does not support an answer, say: 'The provided sources don't contain enough information to answer that.' Never guess or use outside knowledge.\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": {{ JSON.stringify('Question: ' + $json.question + '\\n\\nContext:\\n' + $json.context) }} }\n  ]\n}",
        "options": {}
      },
      "id": "b1a1e001-0000-4000-8000-000000000005",
      "name": "Answer (Claude, cite/refuse)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "ANTHROPIC_HEADER_AUTH", "name": "Anthropic (x-api-key)" }
      }
    },
    {
      "parameters": {
        "jsCode": "const msg = $json;\nconst answer = (msg.content && msg.content[0] && msg.content[0].text) || '';\nconst sources = $('Assemble context').first().json.sources;\nreturn [{ json: { answer, sources } }];"
      },
      "id": "b1a1e001-0000-4000-8000-000000000006",
      "name": "Format response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1160, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "b1a1e001-0000-4000-8000-000000000007",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1400, 300]
    }
  ],
  "connections": {
